# ML-Auditor Environment Variables - PRODUCTION
# Copy to .env.prod and fill in values

# ─── Django ──────────────────────────────────────────────
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=CHANGE_ME_TO_RANDOM_50_CHARS
DJANGO_ALLOWED_HOSTS=mlauditor.com,www.mlauditor.com

# ─── Database ────────────────────────────────────────────
POSTGRES_DB=mlauditor_db
POSTGRES_USER=mlauditor
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ───────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_RANDOM_50_CHARS

# ─── NVIDIA NIM ──────────────────────────────────────────
NIM_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXX
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct

# ─── Plaid ───────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ─── Google OAuth ────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── Canva ───────────────────────────────────────────────
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ─── Sentry ──────────────────────────────────────────────
SENTRY_DSN=

# ─── ML Microservice ─────────────────────────────────────
ML_SERVICE_URL=http://localhost:8001

# ─── Domain ──────────────────────────────────────────────
DOMAIN=mlauditor.com
NEXT_PUBLIC_API_URL=https://mlauditor.com
NEXT_PUBLIC_WS_URL=wss://mlauditor.com

# ─── Scaling ─────────────────────────────────────────────
GUNICORN_WORKERS=4
CELERY_WORKERS=4
ML_WORKERS=2

# ─── Monitoring ──────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME
