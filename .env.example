# Django Configuration
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DJANGO_DATABASE_URL=

# Secrets (generate strong values with scripts/generate_secrets.sh)
SECRET_ENCRYPTION_KEY=
DJANGO_CACHE_URL=

# Celery Configuration
DJANGO_CELERY_BROKER_URL=
DJANGO_CELERY_RESULT_BACKEND=
DJANGO_CHANNELS_LAYERS=

# JWT Configuration
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800

# NVIDIA NIM Configuration
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct

# Plaid Configuration
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must be registered as an Authorized redirect URI in the Google Cloud OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/google/callback

# Canva Configuration
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Microservices
WEB_TOOLS_URL=http://web-tools:8090
JC_URL=http://jobchameleon:8787
JC_MCP_URL=http://jobchameleon:8788/mcp
JC_API_TOKEN=
EXA_API_KEY=

# JobChameleon OpenCLI bridge (optional; defaults shown)
# JC_OPENCLI_ENABLED=true
# JC_OPENCLI_BIN=opencli
# JC_OPENCLI_TIMEOUT_S=90

# Sentry Configuration
SENTRY_DSN=

# ELK Stack (optional — only needed if running services separately)
ELASTICSEARCH_URL=http://localhost:9200
LOGSTASH_TCP_PORT=5000
KIBANA_URL=http://localhost:5601

# Elastic APM (traces for backend, celery, mcp-server)
ELASTIC_APM_ENABLED=true
ELASTIC_APM_SERVER_URL=http://apm-server:8200
ELASTIC_APM_SERVICE_NAME=ml-auditor-backend
DJANGO_ENV=development

# Docker daemon group id (gid) on the host — lets the backend container's
# uid-1000 process use the mounted /var/run/docker.sock (see `group_add` in
# docker-compose.yml). Find it with: getent group docker
DOCKER_GROUP_ID=116
