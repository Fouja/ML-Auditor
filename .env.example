# Django Configuration
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
# Example for local mobile testing: localhost,127.0.0.1,192.168.1.xxx
DJANGO_DATABASE_URL=

# Secrets (generate strong values with scripts/generate_secrets.sh)
SECRET_ENCRYPTION_KEY=
DJANGO_CACHE_URL=

# Celery Configuration
DJANGO_CELERY_BROKER_URL=
DJANGO_CELERY_RESULT_BACKEND=
DJANGO_CHANNELS_LAYERS=

# JWT Configuration
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME=3600
JWT_REFRESH_TOKEN_LIFETIME=604800

# NVIDIA NIM Configuration
NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.3-70b-instruct

# Plaid Configuration
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production

# Google OAuth Configuration
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must be registered as an Authorized redirect URI in the Google Cloud OAuth client.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/google/callback

# Canva Configuration
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
# Must be registered as a Redirect URI in the Canva app settings.
CANVA_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/canva/callback

# Jira OAuth Configuration (optional — API token auth is also supported)
JIRA_OAUTH_CLIENT_ID=
JIRA_OAUTH_CLIENT_SECRET=
# Must be registered as a Callback URL in the Atlassian OAuth 2.0 app.
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/oauth/jira/callback

# Where users are redirected after OAuth approval.
# For the desktop app use a custom protocol, e.g. ml-auditor://oauth/callback
# For web use the dashboard URL.
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:3000/dashboard/integrations

# Microservices
WEB_TOOLS_URL=http://web-tools:8090
JC_URL=http://jobchameleon:8787
JC_MCP_URL=http://jobchameleon:8788/mcp
JC_API_TOKEN=
EXA_API_KEY=

# JobChameleon OpenCLI bridge (optional; defaults shown)
# JC_OPENCLI_ENABLED=true
# JC_OPENCLI_BIN=opencli
# JC_OPENCLI_TIMEOUT_S=90

# Sentry Configuration
SENTRY_DSN=

# ELK Stack (optional — only needed if running services separately)
ELASTICSEARCH_URL=http://localhost:9200
LOGSTASH_TCP_PORT=5000
KIBANA_URL=http://localhost:5601

# Elastic APM (traces for backend, celery, mcp-server)
ELASTIC_APM_ENABLED=true
ELASTIC_APM_SERVER_URL=http://apm-server:8200
ELASTIC_APM_SERVICE_NAME=ml-auditor-backend
DJANGO_ENV=development

# Docker daemon group id (gid) on the host — lets the backend container's
# uid-1000 process use the mounted /var/run/docker.sock (see `group_add` in
# docker-compose.yml). Find it with: getent group docker
DOCKER_GROUP_ID=116
