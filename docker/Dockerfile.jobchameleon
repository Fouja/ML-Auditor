FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_NO_CACHE=1 \
    PIP_NO_CACHE_DIR=1 \
    XDG_DATA_HOME=/app/data

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl \
        build-essential \
        git \
        ca-certificates \
        gnupg \
    && rm -rf /var/lib/apt/lists/*

# OpenCLI (job-application automation against the user's logged-in browser)
# needs Node >= 20. Install a pinned LTS release into /usr/local so it is on
# PATH for both the gateway and any sidecar processes.
RUN curl -fsSL https://nodejs.org/dist/v22.12.0/node-v22.12.0-linux-x64.tar.xz \
        | tar -xJ -C /usr/local --strip-components=1 \
    && node --version && npm --version \
    && npm install -g @jackwener/opencli \
    && opencli --version

RUN pip install --no-cache-dir uv

COPY backend/pyproject.toml backend/uv.lock /app/
RUN uv sync --no-dev --no-install-project

COPY backend /app
COPY start.sh /app/start.sh
RUN chmod +x /app/start.sh && mkdir -p /app/data

EXPOSE 8787 8788

HEALTHCHECK --interval=30s --timeout=10s --start-period=90s --retries=3 \
    CMD curl -sf http://localhost:8787/health || exit 1

CMD ["sh", "/app/start.sh"]
