{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ML-Auditor",
  "version": "0.6.9",
  "identifier": "com.fouja.mlauditor",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev -- --port 3142",
    "devUrl": "http://localhost:3142",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ML-Auditor",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["deb", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "startMenuFolder": "ML-Auditor",
        "installerIcon": "icons/icon.ico",
        "compression": "lzma"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "externalBin": ["binaries/ml-auditor-backend"],
    "resources": ["assets"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ml-auditor"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Fouja/ML-Auditor/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVGMUVDRDE5Q0EwMjY0QzMKUldURFpBTEtHYzBlWCtQWkRJZEpSeWZLaG5Rem9qYjEwcGlETjVMbjh6SThtTnA3VC9RSHhqUkUK"
    }
  }
}
